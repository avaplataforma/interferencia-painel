{
  "name": "interferencia/painel",
  "description": "Sistema central de gestão da Interferência.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {},
  "autoload": {
    "psr-4": {
      "Interferencia\\Kernel\\": "kernel/",
      "Interferencia\\Modules\\": "modules/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Interferencia\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "check": [
      "@php tests/run.php"
    ],
    "db:check": "@php bin/console db:check",
    "migrate:status": "@php bin/console migrate:status",
    "migrate": "@php bin/console migrate",
    "migrate:rollback": "@php bin/console migrate:rollback",
    "user:create-admin": "@php bin/console user:create-admin",
    "whatsapp:media:sync": "@php bin/console whatsapp:media:sync",
    "finance:sync": "@php bin/console finance:sync"
  }
}
