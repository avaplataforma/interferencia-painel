APP_NAME="PAINEL INTER 📊"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000/painel
APP_BASE_PATH=/painel
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=painel_inter
DB_USERNAME=painel_inter
DB_PASSWORD=

LOG_LEVEL=debug
LOG_CHANNEL=application

SESSION_NAME=painel_inter_session
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=Lax

# Reservado para a fase de integração. Nunca versionar valores reais.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
