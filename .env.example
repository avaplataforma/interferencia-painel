APP_NAME="PAINEL INTER 📊"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000/painel
# Use / quando o sistema estiver na raiz de um domínio ou /painel em um subdiretório.
APP_BASE_PATH=/
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=painel_inter
DB_USERNAME=painel_inter
DB_PASSWORD=

LOG_LEVEL=debug
LOG_CHANNEL=application

# Chave longa e exclusiva usada pelo formulário do site oficial.
EXTERNAL_FORM_KEY=

SESSION_NAME=painel_inter_session
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=Lax

# Reservado para a fase de integração. Nunca versionar valores reais.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_SEND_ENABLED=false

ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_PAYMENTS_WRITE_ENABLED=false
AVA_AUTO_RELEASE_FROM=
APP_ENCRYPTION_KEY=
