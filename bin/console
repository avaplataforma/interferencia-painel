<?php

declare(strict_types=1);

use Interferencia\Kernel\Config\Config;
use Interferencia\Kernel\Database\Connection;
use Interferencia\Kernel\Database\MigrationRepository;
use Interferencia\Kernel\Database\Migrator;
use Interferencia\Kernel\Environment\Environment;
use Interferencia\Modules\Identity\PasswordHasher;
use Interferencia\Modules\Identity\UserRepository;
use Interferencia\Modules\WhatsApp\CloudApiClient;
use Interferencia\Modules\WhatsApp\MediaStorage;
use Interferencia\Modules\WhatsApp\MessageRepository;
use Interferencia\Modules\Storage\SpacesIntegrationRepository;
use Interferencia\Modules\Storage\SpacesStorageManager;
use Interferencia\Modules\Finance\AsaasClient;
use Interferencia\Modules\Finance\AsaasSynchronizer;
use Interferencia\Modules\Finance\FinanceRepository;
use Interferencia\Modules\Moodle\MoodleRepository;
use Interferencia\Modules\Moodle\MoodleClient;
use Interferencia\Modules\Moodle\IntegrationRepository as MoodleIntegrationRepository;
use Interferencia\Modules\Moodle\PedagogicalSynchronizer;
use Interferencia\Modules\Moodle\AvaConnectionRepository;
use Interferencia\Modules\Crm\FollowUpRepository;
use Interferencia\Modules\Site\SiteRecoveryService;
use Interferencia\Kernel\Security\SecretCipher;
use Interferencia\Modules\Catalog\CourseProviderRepository;
use Interferencia\Modules\Catalog\ImageGenerationRepository;
use Interferencia\Modules\Catalog\CatalogMediaStorage;
use Interferencia\Modules\Catalog\CatalogCoverGenerator;
use Interferencia\Modules\Catalog\LearningCatalogRepository;
use Interferencia\Modules\Catalog\AvaCatalogPublisher;
use Interferencia\Modules\Catalog\AvaCourseProvisioningService;
use Interferencia\Modules\Catalog\OpenAiCatalogTextClient;

$rootPath = dirname(__DIR__);
$autoload = $rootPath . '/vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "Autoload ausente. Execute: composer dump-autoload\n");
    exit(1);
}

require $autoload;
Environment::load($rootPath . '/.env');
$config = Config::fromDirectory($rootPath . '/config');
$command = $argv[1] ?? 'help';

try {
    if (in_array($command, ['help', '--help', '-h'], true)) {
        fwrite(STDOUT, <<<TEXT
PAINEL INTER 📊

Comandos disponíveis:
  db:check           Verifica a conexão e mostra banco/versão
  migrate:status     Lista migrações e seus estados
  migrate            Executa migrações pendentes
  migrate:rollback   Reverte o último lote de migrações
  user:create-admin  Cria o primeiro administrador de forma interativa
  whatsapp:media:sync  Recupera mídias pendentes da Cloud API
  moodle:profiles:rebuild  Organiza campos complementares já sincronizados

  moodle:pedagogical:sync  Atualiza progresso, notas, acesso e certificados
  site:recoveries:sync  Atualiza alertas e follow-ups de checkouts abandonados
  catalog-images:process  Gera capas pendentes e salva a versão final no Spaces
  ava-courses:process  Processa a fila automática de criação de cursos no AVA
  ava-courses:link-catalog  Vincula itens pendentes da Loja MASTER a cursos individuais (sem tocar o AVA)
  catalog-ai:complete  Preenche textos e capas pendentes da Loja MASTER com IA (lote de 25 por execução)
  catalog:release-ready  Libera cursos prontos da Loja MASTER em lotes (texto IA, capa, carga e preço)

TEXT);
        exit(0);
    }

    $connection = new Connection($config);

    if ($command === 'db:check') {
        $info = $connection->check();
        fwrite(STDOUT, sprintf("Conexão OK\nBanco: %s\nServidor: %s\n", $info->database, $info->serverVersion));
        exit(0);
    }

    if ($command === 'user:create-admin') {
        $name = trim((string) ($argv[2] ?? ''));
        $email = strtolower(trim((string) ($argv[3] ?? '')));

        if ($name === '' || filter_var($email, FILTER_VALIDATE_EMAIL) === false) {
            throw new RuntimeException('Uso: php bin/console user:create-admin "Nome" email@dominio.com');
        }

        $password = readHidden('Senha (mínimo 12 caracteres): ');
        $confirmation = readHidden('Confirme a senha: ');

        if (strlen($password) < 12 || strlen($password) > 4096) {
            throw new RuntimeException('A senha deve possuir entre 12 e 4096 caracteres.');
        }

        if (!hash_equals($password, $confirmation)) {
            throw new RuntimeException('A confirmação da senha não confere.');
        }

        $passwordHash = (new PasswordHasher())->hash($password);
        unset($password, $confirmation);

        // Abra a conexão somente depois da interação e do Argon2id. Alguns
        // ambientes encerram conexões ociosas enquanto o terminal aguarda.
        $users = new UserRepository($connection->pdo());

        if ($users->findByEmail($email) !== null) {
            throw new RuntimeException('Já existe um usuário com esse e-mail.');
        }

        $id = $users->createAdministrator($name, $email, $passwordHash);
        unset($passwordHash);
        fwrite(STDOUT, sprintf("Administrador criado com ID %d.\n", $id));
        exit(0);
    }

    if ($command === 'whatsapp:media:sync') {
        $messages = new MessageRepository($connection->pdo());
        $client = new CloudApiClient(
            (string) $config->get('app.whatsapp_access_token'),
            (string) $config->get('app.whatsapp_graph_version'),
            $config->bool('app.whatsapp_send_enabled'),
        );
        $database=$connection->pdo();
        $spaces=new SpacesStorageManager(new SpacesIntegrationRepository($database,new SecretCipher((string)$config->get('app.encryption_key'))));
        $storage = new MediaStorage($rootPath . '/storage/whatsapp/media',$spaces,'local',0,'WhatsApp');
        $result = $messages->syncPendingMedia($client, $storage, 50);
        if (!$result['available']) {
            throw new RuntimeException('Credenciais da Meta indisponíveis para receber mídias.');
        }
        fwrite(STDOUT, sprintf("Mídias processadas: %d; recuperadas: %d; falhas: %d.\n", $result['processed'], $result['synced'], $result['failed']));
        if (in_array('--cleanup', $argv, true)) {
            $cleanup = $storage->cleanupOrphans($messages->storedMediaPaths(), true);
            fwrite(STDOUT, sprintf("Órfãos encontrados: %d; removidos: %d.\n", $cleanup['candidates'], $cleanup['deleted']));
        }
        exit($result['failed'] === 0 ? 0 : 1);
    }

    if ($command === 'finance:sync') {
        $repository = new FinanceRepository($connection->pdo());
        $client = new AsaasClient((string)$config->get('app.asaas_environment'),(string)$config->get('app.asaas_api_key'));
        $result = (new AsaasSynchronizer($client,$repository))->sync();
        fwrite(STDOUT,sprintf("Sincronização concluída: %d cliente(s), %d cobrança(s) e %d assinatura(s).\n",$result['customers'],$result['payments'],$result['subscriptions']));
        exit(0);
    }

    if ($command === 'moodle:profiles:rebuild') {
        $result=(new MoodleRepository($connection->pdo()))->rebuildProfileFieldsFromStoredUsers();
        fwrite(STDOUT,sprintf("Perfis conferidos: %d; campos complementares encontrados: %d.\n",$result['users'],$result['fields']));
        exit(0);
    }

    if ($command === 'moodle:pedagogical:sync') {
        $lockPath=$rootPath.'/storage/pedagogical-sync.lock';$lock=fopen($lockPath,'c');
        if($lock===false||!flock($lock,LOCK_EX|LOCK_NB))throw new RuntimeException('A sincronização pedagógica já está em execução.');
        try{$database=$connection->pdo();$cipher=new SecretCipher((string)$config->get('app.encryption_key'));$settings=(new MoodleIntegrationRepository($database,$cipher))->settings();$client=new MoodleClient((string)$settings['base_url'],(string)$settings['token'],(bool)$settings['is_active']);$repository=new MoodleRepository($database);$connections=new AvaConnectionRepository($database,$cipher);$unitIds=array_map('intval',$database->query('SELECT id FROM units WHERE is_active=1')->fetchAll(PDO::FETCH_COLUMN));$result=(new PedagogicalSynchronizer($client,$repository,$connections))->sync($unitIds,300);fwrite(STDOUT,sprintf("Acompanhamento atualizado: %d matrícula(s); falhas: %d.\n",$result['updated'],$result['failed']));if($result['last_error']!==null)fwrite(STDERR,"Última falha: ".$result['last_error']."\n");exit($result['updated']===0&&$result['failed']>0?1:0);}
        finally{flock($lock,LOCK_UN);fclose($lock);}
    }

    if ($command === 'catalog:release-ready') {
        $database = $connection->pdo();
        $cipher = new SecretCipher((string) $config->get('app.encryption_key'));
        $providers = new CourseProviderRepository($database, $cipher);
        $limit = max(1, min(100, (int) ($argv[2] ?? 25)));
        $dryRun = in_array('--dry-run', $argv, true);
        $result = $providers->releaseReadyCourses('iesde', $limit, $dryRun, null);
        if ($dryRun) {
            fwrite(STDOUT, sprintf("Prontos para liberação (qualidade mínima): %d. Nenhum item foi alterado.\n", $result['ready']));
        } else {
            fwrite(STDOUT, sprintf("Liberados com qualidade mínima: %d de %d prontos no lote.\n", $result['released'], $result['ready']));
        }
        exit(0);
    }

    if ($command === 'site:recoveries:sync') {
        $database=$connection->pdo();
        $result=(new SiteRecoveryService($database,new FollowUpRepository($database)))->sync(null,1000);
        fwrite(STDOUT,sprintf("Recuperação comercial: %d criada(s), %d alerta(s) avançado(s), %d follow-up(s) e %d cancelada(s).\n",$result['created'],$result['advanced'],$result['follow_ups'],$result['cancelled']));
        exit(0);
    }

    if ($command === 'catalog-images:process') {
        $database=$connection->pdo();
        $cipher=new SecretCipher((string)$config->get('app.encryption_key'));
        $spaces=new SpacesStorageManager(new SpacesIntegrationRepository($database,$cipher));
        $catalogs=new CourseProviderRepository($database,$cipher);
        $images=new ImageGenerationRepository($database,$cipher);
        $media=new CatalogMediaStorage($spaces);
        $limit=max(1,min(20,(int)($argv[2]??1)));
        if(in_array('--retry-failed',$argv,true)){
            $requeued=$images->requeueFailed();
            fwrite(STDOUT,sprintf("Falhas reenfileiradas: %d.\n",$requeued));
        }
        $result=(new CatalogCoverGenerator($images,$catalogs,$media,$spaces))->process($limit);
        fwrite(STDOUT,sprintf("Capas processadas: %d; falhas: %d.\n",$result['processed'],$result['failed']));
        exit($result['failed']>0?1:0);
    }

    if ($command === 'ava-courses:process') {
        $lockPath=$rootPath.'/storage/ava-course-provisioning.lock';$lock=fopen($lockPath,'c');
        if($lock===false||!flock($lock,LOCK_EX|LOCK_NB))throw new RuntimeException('A fila de cursos do AVA já está em execução.');
        try{
            $database=$connection->pdo();
            $cipher=new SecretCipher((string)$config->get('app.encryption_key'));
            $providers=new CourseProviderRepository($database,$cipher);
            $learningCatalog=new LearningCatalogRepository($database);
            $avaConnections=new AvaConnectionRepository($database,$cipher);
            $moodleRepository=new MoodleRepository($database);
            $publisher=new AvaCatalogPublisher($learningCatalog,$avaConnections,$moodleRepository,$providers,$config->string('app.url'));
            $robot=new \Interferencia\Modules\Catalog\IesdeLtiRobot($database,$avaConnections,$providers,$rootPath);
            $service=new AvaCourseProvisioningService($database,$providers,$publisher,$robot);
            if(in_array('--dry-run',$argv,true)){
                $dashboard=$service->dashboard('iesde',5);$summary=$dashboard['summary'];
                fwrite(STDOUT,sprintf("Fila MASTER: %d aguardando, %d processando, %d falha(s), %d exigindo intervenção. Nenhum item foi alterado.\n",$summary['queued'],$summary['working'],$summary['failed'],$summary['attention']));
                exit(0);
            }
            $limit=max(1,min(50,(int)($argv[2]??10)));
            $result=$service->processBatch($limit,3);
            fwrite(STDOUT,sprintf("Fila do AVA: %d encontrado(s), %d processado(s), %d concluído(s), %d falha(s), %d exigindo intervenção.\n",$result['discovered'],$result['processed'],$result['completed'],$result['failed'],$result['exhausted']));
            exit(0);
        }finally{flock($lock,LOCK_UN);fclose($lock);}
    }

    if ($command === 'ava-courses:link-catalog') {
        $database = $connection->pdo();
        $cipher = new SecretCipher((string) $config->get('app.encryption_key'));
        $providers = new CourseProviderRepository($database, $cipher);
        if (in_array('--dry-run', $argv, true)) {
            $pending = $database->query("SELECT COUNT(*) FROM provider_commercial_catalog_items WHERE provider_id=4 AND is_available=1 AND sync_status='pending_lti' AND provider_course_id IS NULL")->fetchColumn();
            fwrite(STDOUT, sprintf("Catálogo MASTER: %d item(ns) pendente(s) de vínculo. Nenhum item foi alterado.\n", (int) $pending));
            exit(0);
        }
        $result = $providers->linkPendingCommercialItems('iesde', null);
        fwrite(STDOUT, sprintf(
            "Catálogo MASTER vinculado: %d pendente(s), %d vinculado(s), %d curso(s) criado(s) no painel, %d pulado(s) por nome duplicado, %d pulado(s) por ambiguidade. Nenhum curso foi criado no AVA.\n",
            $result['total_pending'],
            $result['linked'],
            $result['created'],
            $result['skipped_duplicates'],
            $result['skipped_ambiguous'],
        ));
        exit(0);
    }

    if ($command === 'catalog-ai:complete') {
        $database = $connection->pdo();
        $cipher = new SecretCipher((string) $config->get('app.encryption_key'));
        $providers = new CourseProviderRepository($database, $cipher);
        $images = new ImageGenerationRepository($database, $cipher);
        $spaces = new SpacesStorageManager(new SpacesIntegrationRepository($database, $cipher));
        $media = new CatalogMediaStorage($spaces);
        $coverGenerator = new CatalogCoverGenerator($images, $providers, $media, $spaces);

        $settings = $images->settings(true);
        if (!(bool)($settings['configured'] ?? false) || !(bool)($settings['is_active'] ?? false)) {
            throw new RuntimeException('Ative a integração IA - OpenAI no ADM Central.');
        }
        $client = new OpenAiCatalogTextClient((string) $settings['api_key']);

        $batch = max(1, min(25, (int) ($argv[2] ?? 25)));
        $candidates = $providers->commercialAiCandidates('iesde', $batch);
        if ($candidates === []) {
            fwrite(STDOUT, "Loja MASTER sem pendências de texto ou capa.\n");
            exit(0);
        }

        $texts = 0;
        $queued = 0;
        $failures = 0;
        foreach ($candidates as $candidate) {
            $id = (int) $candidate['id'];
            try {
                if (trim((string) $candidate['commercial_summary']) === '' || trim((string) $candidate['commercial_description']) === '') {
                    $resources = [];
                    foreach ($providers->courseResourcesForCourse($id) as $resource) {
                        $name = trim((string) ($resource['discipline_name'] ?? $resource['name'] ?? ''));
                        if ($name !== '') $resources[mb_strtolower($name)] = $name;
                    }
                    $copy = $resources !== []
                        ? $client->generateMasterCopy((string) $candidate['effective_name'], (string) $candidate['effective_category'], array_values($resources))
                        : $client->generateCourseCopy((string) $candidate['effective_name'], (string) $candidate['effective_category'], (string) $candidate['source_description']);
                    $providers->fillMissingCourseCopy($id, $copy['short_description'], $copy['description'], null);
                    $texts++;
                }
                if ((int) $candidate['has_cover'] !== 1) {
                    try {
                        $coverGenerator->queue('course', $id, '', null);
                        $queued++;
                    } catch (Throwable) {
                    }
                }
            } catch (Throwable) {
                $failures++;
            }
        }

        fwrite(STDOUT, sprintf(
            "IA comercial MASTER: %d texto(s) preenchido(s), %d capa(s) enfileirada(s), %d falha(s). %d candidato(s) restante(s) para a próxima execução.\n",
            $texts,
            $queued,
            $failures,
            max(0, count($candidates) - $texts),
        ));
        exit(0);
    }

    $migrator = new Migrator(
        $connection->pdo(),
        new MigrationRepository($rootPath . '/database/migrations'),
    );

    if ($command === 'migrate:status') {
        $statuses = $migrator->status();

        if ($statuses === []) {
            fwrite(STDOUT, "Nenhuma migração de domínio registrada.\n");
        }

        foreach ($statuses as $status) {
            fwrite(STDOUT, sprintf(
                "[%s] %s%s\n",
                $status->applied ? 'aplicada' : 'pendente',
                $status->id,
                $status->batch === null ? '' : sprintf(' (lote %d)', $status->batch),
            ));
        }

        exit(0);
    }

    if ($command === 'migrate') {
        $executed = $migrator->migrate();
        fwrite(STDOUT, $executed === []
            ? "Nenhuma migração pendente.\n"
            : "Aplicadas:\n- " . implode("\n- ", $executed) . "\n");
        exit(0);
    }

    if ($command === 'migrate:rollback') {
        $reverted = $migrator->rollback();
        fwrite(STDOUT, $reverted === []
            ? "Nenhum lote para reverter.\n"
            : "Revertidas:\n- " . implode("\n- ", $reverted) . "\n");
        exit(0);
    }

    fwrite(STDERR, sprintf("Comando desconhecido: %s\n", $command));
    exit(2);
} catch (Throwable $exception) {
    fwrite(STDERR, sprintf("Falha: %s\n", $exception->getMessage()));
    exit(1);
}

function readHidden(string $prompt): string
{
    fwrite(STDOUT, $prompt);
    $state = trim((string) shell_exec('stty -g'));

    if ($state === '') {
        throw new RuntimeException('Não foi possível preparar a leitura segura da senha.');
    }

    try {
        system('stty -echo');
        $value = fgets(STDIN);
    } finally {
        system('stty ' . escapeshellarg($state));
        fwrite(STDOUT, PHP_EOL);
    }

    if (!is_string($value)) {
        throw new RuntimeException('Não foi possível ler a senha.');
    }

    return rtrim($value, "\r\n");
}
