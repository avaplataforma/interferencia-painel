<?php

declare(strict_types=1);

use Interferencia\Kernel\Config\Config;
use Interferencia\Kernel\Database\Connection;
use Interferencia\Kernel\Database\MigrationRepository;
use Interferencia\Kernel\Database\Migrator;
use Interferencia\Kernel\Environment\Environment;
use Interferencia\Modules\Identity\PasswordHasher;
use Interferencia\Modules\Identity\UserRepository;
use Interferencia\Modules\WhatsApp\CloudApiClient;
use Interferencia\Modules\WhatsApp\MediaStorage;
use Interferencia\Modules\WhatsApp\MessageRepository;
use Interferencia\Modules\Finance\AsaasClient;
use Interferencia\Modules\Finance\AsaasSynchronizer;
use Interferencia\Modules\Finance\FinanceRepository;
use Interferencia\Modules\Moodle\MoodleRepository;
use Interferencia\Modules\Moodle\MoodleClient;
use Interferencia\Modules\Moodle\IntegrationRepository as MoodleIntegrationRepository;
use Interferencia\Modules\Moodle\PedagogicalSynchronizer;
use Interferencia\Kernel\Security\SecretCipher;

$rootPath = dirname(__DIR__);
$autoload = $rootPath . '/vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "Autoload ausente. Execute: composer dump-autoload\n");
    exit(1);
}

require $autoload;
Environment::load($rootPath . '/.env');
$config = Config::fromDirectory($rootPath . '/config');
$command = $argv[1] ?? 'help';

try {
    if (in_array($command, ['help', '--help', '-h'], true)) {
        fwrite(STDOUT, <<<TEXT
PAINEL INTER 📊

Comandos disponíveis:
  db:check           Verifica a conexão e mostra banco/versão
  migrate:status     Lista migrações e seus estados
  migrate            Executa migrações pendentes
  migrate:rollback   Reverte o último lote de migrações
  user:create-admin  Cria o primeiro administrador de forma interativa
  whatsapp:media:sync  Recupera mídias pendentes da Cloud API
  moodle:profiles:rebuild  Organiza campos complementares já sincronizados

  moodle:pedagogical:sync  Atualiza progresso e último acesso dos alunos

TEXT);
        exit(0);
    }

    $connection = new Connection($config);

    if ($command === 'db:check') {
        $info = $connection->check();
        fwrite(STDOUT, sprintf("Conexão OK\nBanco: %s\nServidor: %s\n", $info->database, $info->serverVersion));
        exit(0);
    }

    if ($command === 'user:create-admin') {
        $name = trim((string) ($argv[2] ?? ''));
        $email = strtolower(trim((string) ($argv[3] ?? '')));

        if ($name === '' || filter_var($email, FILTER_VALIDATE_EMAIL) === false) {
            throw new RuntimeException('Uso: php bin/console user:create-admin "Nome" email@dominio.com');
        }

        $password = readHidden('Senha (mínimo 12 caracteres): ');
        $confirmation = readHidden('Confirme a senha: ');

        if (strlen($password) < 12 || strlen($password) > 4096) {
            throw new RuntimeException('A senha deve possuir entre 12 e 4096 caracteres.');
        }

        if (!hash_equals($password, $confirmation)) {
            throw new RuntimeException('A confirmação da senha não confere.');
        }

        $passwordHash = (new PasswordHasher())->hash($password);
        unset($password, $confirmation);

        // Abra a conexão somente depois da interação e do Argon2id. Alguns
        // ambientes encerram conexões ociosas enquanto o terminal aguarda.
        $users = new UserRepository($connection->pdo());

        if ($users->findByEmail($email) !== null) {
            throw new RuntimeException('Já existe um usuário com esse e-mail.');
        }

        $id = $users->createAdministrator($name, $email, $passwordHash);
        unset($passwordHash);
        fwrite(STDOUT, sprintf("Administrador criado com ID %d.\n", $id));
        exit(0);
    }

    if ($command === 'whatsapp:media:sync') {
        $messages = new MessageRepository($connection->pdo());
        $client = new CloudApiClient(
            (string) $config->get('app.whatsapp_access_token'),
            (string) $config->get('app.whatsapp_graph_version'),
            $config->bool('app.whatsapp_send_enabled'),
        );
        $storage = new MediaStorage($rootPath . '/storage/whatsapp/media');
        $result = $messages->syncPendingMedia($client, $storage, 50);
        if (!$result['available']) {
            throw new RuntimeException('Credenciais da Meta indisponíveis para receber mídias.');
        }
        fwrite(STDOUT, sprintf("Mídias processadas: %d; recuperadas: %d; falhas: %d.\n", $result['processed'], $result['synced'], $result['failed']));
        if (in_array('--cleanup', $argv, true)) {
            $cleanup = $storage->cleanupOrphans($messages->storedMediaPaths(), true);
            fwrite(STDOUT, sprintf("Órfãos encontrados: %d; removidos: %d.\n", $cleanup['candidates'], $cleanup['deleted']));
        }
        exit($result['failed'] === 0 ? 0 : 1);
    }

    if ($command === 'finance:sync') {
        $repository = new FinanceRepository($connection->pdo());
        $client = new AsaasClient((string)$config->get('app.asaas_environment'),(string)$config->get('app.asaas_api_key'));
        $result = (new AsaasSynchronizer($client,$repository))->sync();
        fwrite(STDOUT,sprintf("Sincronização concluída: %d cliente(s), %d cobrança(s) e %d assinatura(s).\n",$result['customers'],$result['payments'],$result['subscriptions']));
        exit(0);
    }

    if ($command === 'moodle:profiles:rebuild') {
        $result=(new MoodleRepository($connection->pdo()))->rebuildProfileFieldsFromStoredUsers();
        fwrite(STDOUT,sprintf("Perfis conferidos: %d; campos complementares encontrados: %d.\n",$result['users'],$result['fields']));
        exit(0);
    }

    if ($command === 'moodle:pedagogical:sync') {
        $lockPath=$rootPath.'/storage/pedagogical-sync.lock';$lock=fopen($lockPath,'c');
        if($lock===false||!flock($lock,LOCK_EX|LOCK_NB))throw new RuntimeException('A sincronização pedagógica já está em execução.');
        try{$database=$connection->pdo();$settings=(new MoodleIntegrationRepository($database,new SecretCipher((string)$config->get('app.encryption_key'))))->settings();$client=new MoodleClient((string)$settings['base_url'],(string)$settings['token'],(bool)$settings['is_active']);$repository=new MoodleRepository($database);$unitIds=array_map('intval',$database->query('SELECT id FROM units WHERE is_active=1')->fetchAll(PDO::FETCH_COLUMN));$result=(new PedagogicalSynchronizer($client,$repository))->sync($unitIds,300);fwrite(STDOUT,sprintf("Acompanhamento atualizado: %d matrícula(s); falhas: %d.\n",$result['updated'],$result['failed']));if($result['last_error']!==null)fwrite(STDERR,"Última falha: ".$result['last_error']."\n");exit($result['updated']===0&&$result['failed']>0?1:0);}
        finally{flock($lock,LOCK_UN);fclose($lock);}
    }

    $migrator = new Migrator(
        $connection->pdo(),
        new MigrationRepository($rootPath . '/database/migrations'),
    );

    if ($command === 'migrate:status') {
        $statuses = $migrator->status();

        if ($statuses === []) {
            fwrite(STDOUT, "Nenhuma migração de domínio registrada.\n");
        }

        foreach ($statuses as $status) {
            fwrite(STDOUT, sprintf(
                "[%s] %s%s\n",
                $status->applied ? 'aplicada' : 'pendente',
                $status->id,
                $status->batch === null ? '' : sprintf(' (lote %d)', $status->batch),
            ));
        }

        exit(0);
    }

    if ($command === 'migrate') {
        $executed = $migrator->migrate();
        fwrite(STDOUT, $executed === []
            ? "Nenhuma migração pendente.\n"
            : "Aplicadas:\n- " . implode("\n- ", $executed) . "\n");
        exit(0);
    }

    if ($command === 'migrate:rollback') {
        $reverted = $migrator->rollback();
        fwrite(STDOUT, $reverted === []
            ? "Nenhum lote para reverter.\n"
            : "Revertidas:\n- " . implode("\n- ", $reverted) . "\n");
        exit(0);
    }

    fwrite(STDERR, sprintf("Comando desconhecido: %s\n", $command));
    exit(2);
} catch (Throwable $exception) {
    fwrite(STDERR, sprintf("Falha: %s\n", $exception->getMessage()));
    exit(1);
}

function readHidden(string $prompt): string
{
    fwrite(STDOUT, $prompt);
    $state = trim((string) shell_exec('stty -g'));

    if ($state === '') {
        throw new RuntimeException('Não foi possível preparar a leitura segura da senha.');
    }

    try {
        system('stty -echo');
        $value = fgets(STDIN);
    } finally {
        system('stty ' . escapeshellarg($state));
        fwrite(STDOUT, PHP_EOL);
    }

    if (!is_string($value)) {
        throw new RuntimeException('Não foi possível ler a senha.');
    }

    return rtrim($value, "\r\n");
}
